# Arbor 运维告警配置示例
# 用法: cp 本文件为 ~/.arbor/.env 并填入真实值（~/.arbor/.env 不会被 git 跟踪）
# launchd 常驻进程没有 shell 环境变量，必须走这个文件

# DeepSeek 采购顾问。写入后 /chat/ 和周报点评都走 deepseek-chat。
# 没有这把钥匙时，追问页只用本期简报，不调用模型。
DEEPSEEK_API_KEY=
# 可选。默认模型 deepseek-chat，地址 https://api.deepseek.com
# AGENT_MODEL=deepseek-chat
# AGENT_BASE_URL=https://api.deepseek.com

# Telegram Bot Token（找 @BotFather 创建 bot 获得）
TELEGRAM_BOT_TOKEN=

# 接收告警的 chat_id（给 bot 发任意消息后访问
# https://api.telegram.org/bot<TOKEN>/getUpdates 查看 chat.id）
TELEGRAM_CHAT_ID=
